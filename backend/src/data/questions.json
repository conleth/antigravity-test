{
    "version": "1.0.0",
    "description": "Questionnaire questions for security requirements shortlisting",
    "questions": [
        {
            "id": "app-type",
            "text": "What type of application is this?",
            "helpText": "Select the primary application type. This affects which security controls are most relevant.",
            "type": "single-select",
            "required": true,
            "options": [
                {
                    "value": "web",
                    "label": "Web Application",
                    "description": "Browser-based application with UI"
                },
                {
                    "value": "api",
                    "label": "API Service",
                    "description": "REST/GraphQL backend service"
                },
                {
                    "value": "mobile",
                    "label": "Mobile App",
                    "description": "iOS or Android application"
                },
                {
                    "value": "internal",
                    "label": "Internal Tool",
                    "description": "Internal-only utility or admin tool"
                },
                {
                    "value": "iot",
                    "label": "IoT / Embedded",
                    "description": "Physical device or firmware"
                },
                {
                    "value": "desktop",
                    "label": "Desktop / Electron",
                    "description": "Native desktop application"
                },
                {
                    "value": "serverless",
                    "label": "Serverless Function",
                    "description": "Lambda, Cloud Functions, etc."
                }
            ],
            "mapsTo": "appType",
            "order": 1
        },
        {
            "id": "auth-type",
            "text": "What authentication method does the application use?",
            "helpText": "Select the primary authentication mechanism.",
            "type": "multi-select",
            "required": true,
            "options": [
                {
                    "value": "none",
                    "label": "None / Anonymous",
                    "description": "No authentication required"
                },
                {
                    "value": "basic",
                    "label": "Basic Auth",
                    "description": "Username/Password (HTTP Basic)"
                },
                {
                    "value": "apikey",
                    "label": "API Key",
                    "description": "Static API key/token"
                },
                {
                    "value": "session",
                    "label": "Session-based",
                    "description": "Traditional session cookies"
                },
                {
                    "value": "oauth",
                    "label": "OAuth 2.0 / OIDC",
                    "description": "Token-based authentication"
                },
                {
                    "value": "sso",
                    "label": "Enterprise SSO",
                    "description": "Microsoft Entra, Okta, etc."
                },
                {
                    "value": "saml",
                    "label": "SAML",
                    "description": "Legacy XML-based federated auth"
                }
            ],
            "mapsTo": "authType",
            "order": 2
        },
        {
            "id": "data-sensitivity",
            "text": "What is the highest data sensitivity level handled?",
            "helpText": "Consider the most sensitive data the application processes, stores, or transmits.",
            "type": "single-select",
            "required": true,
            "options": [
                {
                    "value": "public",
                    "label": "Public",
                    "description": "Non-sensitive, publicly available data"
                },
                {
                    "value": "internal",
                    "label": "Internal",
                    "description": "Business data, not for public disclosure"
                },
                {
                    "value": "confidential",
                    "label": "Confidential",
                    "description": "PII, financial data, trade secrets"
                },
                {
                    "value": "regulated",
                    "label": "Regulated",
                    "description": "PCI-DSS, HIPAA, GDPR sensitive data"
                }
            ],
            "mapsTo": "dataSensitivity",
            "order": 3
        },
        {
            "id": "internet-exposure",
            "text": "What is the network exposure of this application?",
            "helpText": "Consider how the application is accessed.",
            "type": "single-select",
            "required": true,
            "options": [
                {
                    "value": "public",
                    "label": "Public Internet",
                    "description": "Accessible from the internet"
                },
                {
                    "value": "private",
                    "label": "Private Network Only",
                    "description": "VPN or internal network only"
                },
                {
                    "value": "mixed",
                    "label": "Mixed",
                    "description": "Some components public, some private"
                }
            ],
            "mapsTo": "internetExposure",
            "order": 4
        },
        {
            "id": "hosting-model",
            "text": "Where is the application hosted?",
            "helpText": "Select the primary hosting environment.",
            "type": "single-select",
            "required": true,
            "options": [
                {
                    "value": "onprem",
                    "label": "On-Premises",
                    "description": "Self-managed data center"
                },
                {
                    "value": "cloud",
                    "label": "Cloud",
                    "description": "AWS, GCP, Azure, etc."
                },
                {
                    "value": "hybrid",
                    "label": "Hybrid",
                    "description": "Mix of on-prem and cloud"
                }
            ],
            "mapsTo": "hostingModel",
            "order": 5
        },
        {
            "id": "is-containerized",
            "text": "Is the application containerized?",
            "helpText": "Using Docker, Kubernetes, etc. Only relevant for Cloud/Hybrid hosting.",
            "type": "boolean",
            "required": true,
            "condition": {
                "questionId": "hosting-model",
                "operator": "in",
                "value": [
                    "cloud",
                    "hybrid"
                ]
            },
            "mapsTo": "isContainerized",
            "order": 6
        },
        {
            "id": "is-multi-tenant",
            "text": "Is this a multi-tenant application?",
            "helpText": "Multiple clients or organizations sharing the same infrastructure/database.",
            "type": "boolean",
            "required": true,
            "mapsTo": "isMultiTenant",
            "order": 7
        },
        {
            "id": "compliance-targets",
            "text": "Which compliance frameworks apply to this project?",
            "helpText": "Multiple selections possible. This will include mandatory controls for these standards.",
            "type": "multi-select",
            "required": false,
            "options": [
                {
                    "value": "pci",
                    "label": "PCI-DSS",
                    "description": "Payment card industry data security"
                },
                {
                    "value": "gdpr",
                    "label": "GDPR",
                    "description": "European data protection"
                },
                {
                    "value": "soc2",
                    "label": "SOC2",
                    "description": "Service organization controls"
                },
                {
                    "value": "hipaa",
                    "label": "HIPAA",
                    "description": "Healthcare data privacy/security"
                },
                {
                    "value": "nist",
                    "label": "NIST 800-53",
                    "description": "US Federal Information Systems"
                },
                {
                    "value": "iso27001",
                    "label": "ISO 27001",
                    "description": "International info-sec standard"
                }
            ],
            "mapsTo": "complianceTargets",
            "order": 8
        },
        {
            "id": "has-legacy-systems",
            "text": "Does this application integrate with legacy or EOL systems?",
            "helpText": "Systems that may not support modern security protocols.",
            "type": "boolean",
            "required": true,
            "mapsTo": "hasLegacySystems",
            "order": 9
        },
        {
            "id": "pipeline-ci",
            "text": "Do you have automated CI/CD pipelines?",
            "helpText": "Continuous integration and deployment automation",
            "type": "boolean",
            "required": true,
            "mapsTo": "pipelineMaturity.hasCI",
            "order": 10
        },
        {
            "id": "pipeline-signing",
            "text": "Are build artifacts cryptographically signed?",
            "helpText": "Code signing, container image signing, etc.",
            "type": "boolean",
            "required": true,
            "mapsTo": "pipelineMaturity.hasSignedArtifacts",
            "order": 11
        },
        {
            "id": "pipeline-secrets",
            "text": "Do you have automated secret scanning?",
            "helpText": "Tools that detect leaked credentials in code",
            "type": "boolean",
            "required": true,
            "mapsTo": "pipelineMaturity.hasSecretScanning",
            "order": 12
        },
        {
            "id": "pipeline-iac",
            "text": "Do you use Infrastructure as Code (IaC)?",
            "helpText": "Terraform, CloudFormation, Pulumi, etc.",
            "type": "boolean",
            "required": true,
            "mapsTo": "pipelineMaturity.hasIaC",
            "order": 13
        },
        {
            "id": "pipeline-sbom",
            "text": "Do you generate Software Bill of Materials (SBOM)?",
            "helpText": "CycloneDX, SPDX, or similar dependency tracking",
            "type": "boolean",
            "required": true,
            "mapsTo": "pipelineMaturity.hasSBOM",
            "order": 14
        }
    ]
}